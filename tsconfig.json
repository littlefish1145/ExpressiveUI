{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@expressive-ui/core": ["packages/core/src/index.ts"],
      "@expressive-ui/tokens": ["packages/tokens/src/index.ts"],
      "@expressive-ui/shape": ["packages/shape/src/index.ts"],
      "@expressive-ui/motion": ["packages/motion/src/index.ts"],
      "@expressive-ui/theme": ["packages/theme/src/index.ts"],
      "@expressive-ui/theme/runtime": ["packages/theme/src/runtime.ts"],
      "@expressive-ui/components": ["packages/components/src/index.ts"],
      "@expressive-ui/adapter-react": ["packages/adapter-react/src/index.tsx"]
    }
  },
  "include": ["packages", "playground", "tests", "*.config.ts"]
}
