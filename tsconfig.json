{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@epui/core": ["packages/core/src/index.ts"],
      "@epui/tokens": ["packages/tokens/src/index.ts"],
      "@epui/shape": ["packages/shape/src/index.ts"],
      "@epui/motion": ["packages/motion/src/index.ts"],
      "@epui/theme": ["packages/theme/src/index.ts"],
      "@epui/theme/runtime": ["packages/theme/src/runtime.ts"],
      "@epui/components": ["packages/components/src/index.ts"],
      "@epui/adapter-react": ["packages/adapter-react/src/index.tsx"]
    }
  },
  "include": ["packages", "playground", "tests", "*.config.ts"]
}
