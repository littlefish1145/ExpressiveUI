{
  "name": "@amiracle1024/shape",
  "version": "0.1.0",
  "description": "Material 3 Expressive shape for the Web",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@amiracle1024/core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littlefish1145/ExpressiveUI.git",
    "directory": "packages/shape"
  },
  "homepage": "https://github.com/littlefish1145/ExpressiveUI/tree/main/packages/shape#readme",
  "bugs": {
    "url": "https://github.com/littlefish1145/ExpressiveUI/issues"
  },
  "keywords": [
    "material-design",
    "material-3",
    "expressive",
    "typescript",
    "shape"
  ],
  "scripts": {
    "prepack": "node ../../scripts/check-package.mjs"
  }
}
